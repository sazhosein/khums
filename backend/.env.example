# ── سرور ──
PORT=3000
NODE_ENV=development

# ── پایگاه داده PostgreSQL ──
DATABASE_URL=postgres://khums_user:strong_password@localhost:5432/khumsyar

# ── احراز هویت ──
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# ── پیامک OTP (کاوه‌نگار / ملی‌پیامک / فراز اس‌ام‌اس) ──
SMS_PROVIDER=kavenegar
SMS_API_KEY=your_sms_api_key
SMS_SENDER=10008663
OTP_TTL_SECONDS=120
OTP_LENGTH=5

# ── درگاه‌های پرداخت ──
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
IDPAY_API_KEY=your_idpay_api_key
SAMAN_TERMINAL_ID=your_saman_terminal
SAMAN_TERMINAL_PASSWORD=your_saman_password

# ── آدرس بازگشت ──
PAYMENT_CALLBACK_URL=https://api.khumsyar.app/v1/payments/callback
